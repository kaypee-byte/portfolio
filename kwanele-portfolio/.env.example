# Used only at deploy time by scripts/make-config.mjs (Netlify / Cloudflare Pages / Vercel env settings).
# The anon key is public by design; protection comes from the Row Level Security rules in supabase/schema.sql.
# NEVER put the service_role key in this project.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
